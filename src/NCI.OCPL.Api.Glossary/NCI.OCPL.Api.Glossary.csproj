<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="wwwroot\" />
    </ItemGroup>

    <!-- Enable .NET analyzers and set the analysis level to the latest available. -->
    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <!-- Elasticsearch doesn't strictly follow semantic versioning; the client MUST
            be locked to the same version as the server. -->
        <PackageReference Include="Elastic.Clients.Elasticsearch" Version="8.19.12" />
        <PackageReference Include="NCI.OCPL.Api.Common" Version="4.0.0" />
    </ItemGroup>

</Project>
